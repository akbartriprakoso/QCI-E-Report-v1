# QCI E-Report configuration
PORT=8090
SERVER_HOST=0.0.0.0
DATA_MODE=database

# SQL Server service account. Grant SELECT only on the report tables/views.
# Per-source *_USER and *_PASSWORD variables can override these shared credentials.
DB_USER=qci_ereport_ro
DB_PASSWORD=change-me
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=120000
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000

# Direct source databases. Database names and servers below match the current plant topology.
DATAQC_DB_SERVER=10.13.5.193
DATAQC_DB_DATABASE=DATAQC
BULK_S3_DB_SERVER=10.13.10.167
BULK_S3_DB_DATABASE=BulkSampler20
BULK_LOCAL_DB_SERVER=10.13.5.193
BULK_LOCAL_DB_DATABASE=BulkSampler20
PRODUCTION_DB_SERVER=10.13.5.193
PRODUCTION_DB_DATABASE=DATAPRODUKSI

# Optional per-source credentials when the databases do not share one service account.
# DATAQC_DB_USER=
# DATAQC_DB_PASSWORD=
# BULK_S3_DB_USER=
# BULK_S3_DB_PASSWORD=
# BULK_LOCAL_DB_USER=
# BULK_LOCAL_DB_PASSWORD=
# PRODUCTION_DB_USER=
# PRODUCTION_DB_PASSWORD=

# Report response cache: fresh data window and stale-while-revalidate window.
REPORT_CACHE_TTL_MS=5000
REPORT_STALE_TTL_MS=30000

# UI metadata
PLANT_NAME=Krian
APP_TITLE=QCI E-Report
APP_OWNER=Akbar Tri Prakoso
