# QCI E-Report configuration
PORT=8090
SERVER_HOST=0.0.0.0
DATA_MODE=legacy-api

# Existing Portal QC API currently used in the plant.
# This lets E-Report reuse the working data flow first, without copying SQL credentials.
LEGACY_API_BASE=http://10.13.5.151:5000/api

# Report response cache: fresh data window and stale-while-revalidate window.
REPORT_CACHE_TTL_MS=5000
REPORT_STALE_TTL_MS=30000

# UI metadata
PLANT_NAME=Krian
APP_TITLE=QCI E-Report
APP_OWNER=Akbar Tri Prakoso
